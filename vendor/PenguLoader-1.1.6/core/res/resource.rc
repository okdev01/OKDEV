#include "winres.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
1 VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "OKDEV"
   VALUE "FileDescription", "OKDEV Loader core module"
   VALUE "FileVersion", "1.1.0"
   VALUE "InternalName", "core.dll"
   VALUE "LegalCopyright", "Pengu Loader contributors (MIT); OKDEV modifications"
   VALUE "OriginalFilename", "core.dll"
   VALUE "ProductName", "OKDEV"
   VALUE "ProductVersion", "1.1.0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
